{
    "name": "HOL Light",
    "scopeName": "source.hol-light-ocaml",
    "fileTypes": ["hl"],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "begin": "\\(\\*",
                    "end": "\\*\\)",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.comment.begin.ocaml"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.comment.end.ocaml"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#comments"
                        }
                    ],
                    "name": "comment.block.ocaml"
                }
            ]
        }
    },
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "begin": "`",
            "end": "`",
            "patterns": [
                {
                    "include": "source.hol-light-term"
                }
            ],
            "--name": "meta.embedded.block.hol-light-term",
            "name": "string.quoted.single.hol-light-term",
            "contentName": "strong"
        },
        {
            "begin": "\"",
            "end": "\"",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.definition.string.begin.ocaml"
                }
            },
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.string.end.ocaml"
                }
            },
            "patterns": [
                {
                    "match": "\\\\(x[a-fA-F0-9][a-fA-F0-9]|o[0-3][0-7][0-7]|[0-2]\\d\\d|[ bnrt'\"\\\\])",
                    "name": "constant.character.string.escape.ocaml"
                }
            ],
            "name": "string.quoted.double.ocaml"
        },
        {
            "match": "(?<![a-zA-Z0-9_'])'([^'\\\\\\r\\n]|\\\\(x[a-fA-F0-9]{2}|o[0-3][0-7]{2}|25[0-5]|2[0-4]\\d|[01]\\d\\d|[ bnrt'\"\\\\]))'(?![a-zA-Z0-9_'])",
            "name": "constant.character.ocaml"
        },
        {
            "match": "\\b(true|false)\\b",
            "name": "constant.language.boolean.ocaml"
        },
        {
            "match": "(?<![a-zA-Z0-9_'])(?:0[xX][\\dA-Fa-f][\\dA-Fa-f_]*(?:\\.[\\dA-Fa-f_]*(?:[pP][+-]?\\d[\\d_]*)?|[pP][+-]?\\d[\\d_]*)|\\d[\\d_]*(?:\\.[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?|[eE][+-]?\\d[\\d_]*))(?![a-zA-Z0-9_'])",
            "name": "constant.numeric.float.ocaml"
        },
        {
            "match": "(?<![a-zA-Z0-9_'])(?:0[xX][\\dA-Fa-f][\\dA-Fa-f_]*|0[oO][0-7][0-7_]*|0[bB][01][01_]*|\\d[\\d_]*)[lLn]?(?![a-zA-Z0-9_'])",
            "name": "constant.numeric.integer.ocaml"
        },
        {
            "match": "\\bnot\\b|&&|\\|\\|",
            "name": "keyword.operator.logical.ocaml"
        },
        {
            "match": "->|<-|::|:=|<>|<=|>=|==|!=|\\*\\*|\\|>|@@|[+*/\\-]\\.?|[=<>@^|!]|\\b(mod|land|lor|lxor|lsl|lsr|asr)\\b",
            "name": "keyword.operator.ocaml"
        },
        {
            "match": ";;",
            "name": "punctuation.terminator.expression.ocaml"
        },
        {
            "match": "\\b(?:let|and)[*+]|\\b(let|in|and|rec|nonrec|open|include|module|functor|sig|struct|val|external|constraint|private|virtual|fun|function|begin|end|ref|mutable|type|as|of|exception|lazy|class|object|method|inherit|initializer|new)\\b",
            "name": "keyword.other.ocaml"
        },
        {
            "match": "\\b(if|then|else|while|do|done|match|when|with|for|to|downto|try|raise|assert)\\b",
            "name": "keyword.control.ocaml"
        },

        {
            "match": "\\b(THEN|THENL|ORELSE|THEN_TCL|ORELSE_TCL|REPEAT|REPEAT_TCL|REPLICATE_TAC|TRY|CHANGED_TAC|VALID|EVERY|FIRST|MAP_EVERY|MAP_FIRST|EVERY_TCL|FIRST_TCL|ALL_TAC|NO_TAC|ALL_THEN|NO_THEN)\\b",
            "name": "keyword.other.hol-light"
        },
        {
            "match": "\\b(needs|loads|loadt)\\b",
            "name": "keyword.control.import.hol-light"
        },
        {
            "match": "\\b(CHEAT_TAC|new_axiom|mk_thm)\\b",
            "name": "invalid.axiom.hol-light markup.underline"
        }
        
    ]
}